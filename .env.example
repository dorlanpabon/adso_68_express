# Backend — variables de entorno (COPIAR a .env y completar valores privados)
# Nunca subir el archivo .env real al repositorio.

# Entorno: development | production
NODE_ENV=development

# Puerto HTTP del backend
PORT=3000

# Base de datos MySQL (XAMPP local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=adso_68_express
DB_USER=root
# Contraseña de root: NO dejarla en el repo; en este equipo local está vacía.
DB_PASSWORD=

# Origen permitido por CORS (frontend Vite en desarrollo)
FRONTEND_URL=http://localhost:5173

# Secreto de JWT. En producción: mínimo 32 caracteres generados aleatoriamente,
# distintos al valor de desarrollo y guardados como secreto del proveedor.
JWT_SECRET=cambiar_por_un_valor_aleatorio_de_al_menos_32_caracteres
